---
import { getCollection, getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../../layouts/Layout.astro';
import ArticleLayout from '../../../layouts/ArticleLayout.astro';

const intro = await getEntry('alimentos', 'cereales/que-son');
const { Content, headings } = await render(intro!);

const articulos = (await getCollection('alimentos', ({ data, id }) =>
  !data.draft && id.startsWith('cereales/')
)).sort((a, b) => {
  const da = ((a.data as Record<string, unknown>).date as Date | undefined)?.getTime() ?? 0;
  const db = ((b.data as Record<string, unknown>).date as Date | undefined)?.getTime() ?? 0;
  return db - da;
});

const PAGE_SIZE = 8;
const grupos = Array.from(
  { length: Math.ceil(articulos.length / PAGE_SIZE) },
  (_, i) => articulos.slice(i * PAGE_SIZE, (i + 1) * PAGE_SIZE)
);

// ── Subcategorías (nivel 3) ─────────────────────────────────
// Solo se muestran las que ya tienen página creada, para no dejar
// enlaces rotos mientras se construyen una a una.
const subDefiniciones = [
  {
    slug:  'con-gluten',
    label: 'Cereales con gluten',
    desc:  'Avena, trigo, cebada, centeno: gramíneas que fabrican gluten o conviven de cerca con las que lo hacen.',
  },
  {
    slug:  'sin-gluten',
    label: 'Cereales sin gluten',
    desc:  'Arroz, avena sin gluten, maíz: gramíneas que nunca han fabricado esa proteína.',
  },
  {
    slug:  'pseudocereales',
    label: 'Pseudocereales',
    desc:  'Quinoa, amaranto, trigo sarraceno: semillas de otras familias de plantas que se cocinan como cereales.',
  },
];

const dirsExistentes = new Set(
  Object.keys(import.meta.glob('./*/index.astro')).map(f => f.split('/')[1])
);
const subcategorias = await Promise.all(
  subDefiniciones
    .filter(s => dirsExistentes.has(s.slug))
    .map(async s => {
      const entrada = await getEntry('alimentos', `cereales/${s.slug}/que-son`);
      return { ...s, image: entrada?.data.image, imageAlt: entrada?.data.imageAlt ?? s.label };
    })
);

const hermanas = [
  { label: 'Verduras y hortalizas', href: '/alimentos/verduras-hortalizas' },
  { label: 'Frutas',                href: '/alimentos/frutas' },
  { label: 'Legumbres',             href: '/alimentos/legumbres' },
  { label: 'Frutos secos',          href: '/alimentos/frutos-secos' },
];

const migas = [{ href: '/alimentos', label: 'Alimentos' }];
---

<Layout title="Cereales y pseudocereales" description={intro!.data.description}>
  <div class="container seccion">
    <ArticleLayout
      title="Cereales y pseudocereales"
      description={intro!.data.description}
      image={intro!.data.image}
      imageAlt={intro!.data.imageAlt}
      breadcrumbs={migas}
      headings={headings}
      relacionados={[]}
      hermanas={hermanas}
      categoriaLabel="Alimentos"
    >
      <Content />
    </ArticleLayout>

    {subcategorias.length > 0 && (
      <section class="seccion seccion-subcategorias">
        <h2 class="titulo-seccion">Profundiza</h2>
        <div class="grid-articulos">
          {subcategorias.map(sub => (
            <a href={`/alimentos/cereales/${sub.slug}`} class="tarjeta tarjeta-articulo">
              {sub.image && (
                <Image src={sub.image} alt={sub.imageAlt} class="tarjeta-imagen" />
              )}
              <div class="tarjeta-articulo-inner">
                <h2>{sub.label}</h2>
                <p>{sub.desc}</p>
                <span class="leer-mas">Ver artículos →</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    {articulos.length > 0 && (
      <section class="seccion seccion-todos">
        <h2 class="titulo-seccion">Todos los artículos en Cereales y pseudocereales</h2>

        {grupos.length > 1 && (
          <p class="paginacion-info" id="paginacion-info" aria-live="polite">
            Página 1 de {grupos.length}
          </p>
        )}

        {grupos.map((grupo, idx) => (
          <div
            class="grupo-articulos"
            data-pagina={idx + 1}
            style={idx > 0 ? 'display:none' : ''}
          >
            <div class="grid-articulos">
              {grupo.map(e => (
                <a href={`/alimentos/${e.id}`} class="tarjeta tarjeta-articulo">
                  {e.data.image && (
                    <Image src={e.data.image} alt={e.data.imageAlt ?? e.data.title} class="tarjeta-imagen" />
                  )}
                  <div class="tarjeta-articulo-inner">
                    <h2>{e.data.title}</h2>
                    {e.data.description && <p>{e.data.description}</p>}
                    <span class="leer-mas">Leer artículo →</span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        ))}

        {grupos.length > 1 && (
          <nav class="paginacion" aria-label="Paginación de artículos">
            <button id="btn-anterior" class="btn btn-contorno" disabled>← Anterior</button>
            <button id="btn-siguiente" class="btn btn-primario">Siguiente →</button>
          </nav>
        )}
      </section>
    )}
  </div>
</Layout>

<script>
  const grupos = document.querySelectorAll<HTMLElement>('.grupo-articulos');
  const btnAnterior = document.getElementById('btn-anterior') as HTMLButtonElement | null;
  const btnSiguiente = document.getElementById('btn-siguiente') as HTMLButtonElement | null;
  const infoPaginacion = document.getElementById('paginacion-info');
  const totalPaginas = grupos.length;
  let paginaActual = 1;

  function mostrarPagina(n: number) {
    grupos.forEach((g, i) => {
      g.style.display = i + 1 === n ? '' : 'none';
    });
    if (btnAnterior) btnAnterior.disabled = n === 1;
    if (btnSiguiente) btnSiguiente.disabled = n === totalPaginas;
    if (infoPaginacion) infoPaginacion.textContent = `Página ${n} de ${totalPaginas}`;
    paginaActual = n;
  }

  btnAnterior?.addEventListener('click', () => {
    if (paginaActual > 1) mostrarPagina(paginaActual - 1);
  });

  btnSiguiente?.addEventListener('click', () => {
    if (paginaActual < totalPaginas) mostrarPagina(paginaActual + 1);
  });
</script>

<style>
  .seccion-subcategorias,
  .seccion-todos {
    border-top: 1px solid var(--borde);
  }
  .paginacion-info {
    color: var(--texto-suave);
    font-size: 0.875rem;
    margin-bottom: 1.5rem;
  }
  .paginacion {
    display: flex;
    gap: 1rem;
    margin-top: 2.5rem;
    justify-content: center;
  }
  .paginacion .btn:disabled {
    opacity: 0.4;
    cursor: default;
    pointer-events: none;
  }

  @media (max-width: 480px) {
    .paginacion {
      flex-direction: column;
      align-items: stretch;
      text-align: center;
    }
  }
</style>
